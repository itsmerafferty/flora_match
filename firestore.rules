rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isSeller(sellerId) {
      return isAuthenticated() && request.auth.uid == sellerId;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ============ USERS COLLECTION ============
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile during signup
      allow create: if isOwner(userId) && 
                       request.resource.data.role in ['buyer', 'seller', 'admin'];
      
      // Users can update their own profile
      allow update: if isOwner(userId) &&
                       !('role' in request.resource.data.diff(resource.data).affectedKeys()) ||
                       isAdmin();
      
      // Deny delete (soft delete via metadata.accountStatus)
      allow delete: if false;
    }

    // ============ STORES COLLECTION ============
    match /stores/{storeId} {
      // Public read for store info (seller shop)
      allow read: if true;
      
      // Seller can create their store
      allow create: if isOwner(storeId) &&
                       request.resource.data.verification.status == 'pending';
      
      // Seller can update their own store
      allow update: if isSeller(storeId) &&
                       !('verification' in request.resource.data.diff(resource.data).affectedKeys());
      
      // Admin can approve/reject store verification
      allow update: if isAdmin() && 
                       'verification.status' in request.resource.data.diff(resource.data).affectedKeys();
      
      allow delete: if false;
    }

    // ============ PRODUCTS COLLECTION ============
    match /products/{productId} {
      // Public read for browsing
      allow read: if true;
      
      // Seller can create products
      allow create: if isAuthenticated() &&
                       request.resource.data.sellerId == request.auth.uid;
      
      // Seller can update their own products
      allow update: if isSeller(resource.data.sellerId);
      
      // Seller can delete their own products
      allow delete: if isSeller(resource.data.sellerId);
    }

    // ============ INVENTORY COLLECTION ============
    match /inventory/{inventoryId} {
      // Seller can read their own inventory
      allow read: if isAuthenticated() &&
                      resource.data.sellerId == request.auth.uid;
      
      // System (Cloud Functions) can update inventory
      allow write: if false; // Only backend can modify
    }

    // ============ CARTS COLLECTION ============
    match /carts/{cartId} {
      // User can read/write their own cart
      allow read, write: if isOwner(cartId);
    }

    // ============ ORDERS COLLECTION ============
    match /orders/{orderId} {
      // Buyer can read their own orders
      allow read: if isOwner(resource.data.buyerId);
      
      // Seller can read orders they're selling
      allow read: if isSeller(resource.data.sellerId);
      
      // Admin can read all orders
      allow read: if isAdmin();
      
      // System creates orders (Cloud Functions)
      allow create: if false;
      
      // Seller can update order status
      allow update: if isSeller(resource.data.sellerId) &&
                       'fulfillment.status' in request.resource.data.diff(resource.data).affectedKeys();
      
      // Admin can cancel orders
      allow update: if isAdmin();
      
      allow delete: if false;
    }

    // ============ ORDER ITEMS COLLECTION ============
    match /orderItems/{orderItemId} {
      // Buyer/Seller can read their order items
      allow read: if isAuthenticated();
      
      // System only
      allow write: if false;
    }

    // ============ PAYMENTS COLLECTION ============
    match /payments/{paymentId} {
      // Buyer can read their own payments
      allow read: if isOwner(resource.data.buyerId);
      
      // Seller can read payments for their orders
      allow read: if isSeller(resource.data.sellerId);
      
      // Admin can read all payments
      allow read: if isAdmin();
      
      // System only (Cloud Functions + Xendit webhooks)
      allow write: if false;
    }

    // ============ SHIPMENTS COLLECTION ============
    match /shipments/{shipmentId} {
      // Buyer can read their shipments
      allow read: if isOwner(resource.data.buyerId);
      
      // Seller can read their shipments
      allow read: if isSeller(resource.data.sellerId);
      
      // System only
      allow write: if false;
    }

    // ============ REFUNDS COLLECTION ============
    match /refunds/{refundId} {
      // Buyer can read their refunds
      allow read: if isOwner(resource.data.buyerId);
      
      // Seller can read refunds for their orders
      allow read: if isSeller(resource.data.sellerId);
      
      // Admin can read all refunds
      allow read: if isAdmin();
      
      // Buyer can request refund
      allow create: if isOwner(resource.data.buyerId) &&
                       resource.data.initiatedBy == 'buyer';
      
      // Seller can approve/reject refund
      allow update: if isSeller(resource.data.sellerId) &&
                       ('approval' in request.resource.data.diff(resource.data).affectedKeys() ||
                        'status' in request.resource.data.diff(resource.data).affectedKeys());
      
      allow delete: if false;
    }

    // ============ DISPUTES COLLECTION ============
    match /disputes/{disputeId} {
      // Buyer/Seller can read their disputes
      allow read: if isOwner(resource.data.buyerId) ||
                      isSeller(resource.data.sellerId) ||
                      isAdmin();
      
      // Buyer can create dispute
      allow create: if isOwner(resource.data.buyerId) &&
                       resource.data.initiatedBy == 'buyer';
      
      // Admin can update disputes
      allow update: if isAdmin();
      
      allow delete: if false;
    }

    // ============ REVIEWS COLLECTION ============
    match /reviews/{reviewId} {
      // Public read
      allow read: if true;
      
      // Buyer can create review (must be verified purchase)
      allow create: if isOwner(resource.data.buyerId);
      
      // Buyer can update their own review
      allow update: if isOwner(resource.data.buyerId);
      
      // Seller can add response
      allow update: if isSeller(resource.data.sellerId) &&
                       'sellerResponse' in request.resource.data.diff(resource.data).affectedKeys();
      
      allow delete: if false;
    }

    // ============ WALLETS COLLECTION ============
    match /wallets/{walletId} {
      // Seller can read their own wallet
      allow read: if isSeller(walletId);
      
      // Admin can read all wallets
      allow read: if isAdmin();
      
      // System only
      allow write: if false;
    }

    // ============ SETTLEMENTS COLLECTION ============
    match /settlements/{settlementId} {
      // Seller can read their own settlements
      allow read: if isAuthenticated() &&
                      resource.data.sellerId == request.auth.uid;
      
      // Admin can read all settlements
      allow read: if isAdmin();
      
      // System only
      allow write: if false;
    }

    // ============ TRANSACTIONS COLLECTION ============
    match /transactions/{transactionId} {
      // Seller can read their own transactions
      allow read: if isAuthenticated() &&
                      resource.data.sellerId == request.auth.uid;
      
      // System only
      allow write: if false;
    }

    // ============ METADATA COLLECTION ============
    match /_metadata/{document=**} {
      // System only
      allow read: if false;
      allow write: if false;
    }

    // ============ DEFAULT DENY ============
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
